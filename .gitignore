# ──────────────────────────────────────────────────
# Teas Launcher — .gitignore
# Rust + Tauri v2 + Vue 3 + TypeScript
# ──────────────────────────────────────────────────

# ════════════ Rust / Cargo ════════════
# 编译产物
debug/
target/

# Cargo 锁文件 (库项目不提交，但应用项目应提交用于可重现构建)
# 本项目 Cargo.lock 已提交，如需排除请取消下行注释
# Cargo.lock

# Rust 备份文件
**/*.rs.bk

# MSVC Windows 调试信息
*.pdb

# ════════════ Node.js / npm ════════════
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ════════════ Tauri ════════════
# 构建产物 (由 CI 或手动构建生成)
src-tauri/target/

# Tauri 开发服务器生成的代码
src-tauri/gen/

# ════════════ Vite / Frontend ════════════
dist/
dist-ssr/
.vite/

# ════════════ IDE / 编辑器 ════════════
# JetBrains
.idea/
*.iml

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Cursor
.cursor/

# ════════════ 操作系统 ════════════
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ════════════ 环境 / 配置 ════════════
.env
.env.local
.env.*.local

# ════════════ 日志 ════════════
*.log
logs/

# ════════════ 杂项 ════════════
# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~

# 打包输出
*.zip
*.tar.gz
*.rar

# ════════════ 启动器运行时产物 ════════════
# 便携版发行目录。Release 模式下 teas_dir() / get_minecraft_dir() 都取 exe 所在目录，
# 所以从这里运行启动器会在同目录生成 .teas/、versions/、libraries/、assets/，
# 堆积上百 MB 的 Minecraft 资源库 (assets/objects 下是哈希命名的 jar/ogg/资源文件)。
# 这些是构建产物 + 可重新下载的游戏数据，不是源码。
/release/

# 启动器自身数据 (tc.ini、launcher.log)
.teas/

# 下载中断残留 (download/engine.rs 以 .dlpart 作为临时后缀)
*.dlpart

# 若直接从仓库根目录运行 release 版 exe，启动器会把 Minecraft 目录结构
# 建在这里。全部加 "/" 前缀锚定根目录，避免误伤 src/assets/ 等源码目录。
/versions/
/libraries/
/assets/
/teas-latest-launch.bat
/.tmp_*.zip
/.tmp_*/

# ════════════ 工具 ════════════
.reasonix/
