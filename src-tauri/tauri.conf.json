{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2-docs/refs/heads/main/src/content/docs/_schema/v2/config.schema.json",
  "productName": "Teas Launcher",
  "version": "0.1.0",
  "identifier": "com.teaslauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Teas Launcher",
        "width": 1100,
        "height": 640,
        "minWidth": 1100,
        "minHeight": 640,
        "maximizable": false,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {}
  }
}
